{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ara.invalid/contracts/limits-v1.json",
  "title": "ARA limits document v1",
  "type": "object",
  "required": ["schema_version", "account_id", "device_id", "account", "device", "period"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "account_id": { "type": "string", "minLength": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "account": { "$ref": "#/$defs/scope" },
    "device": { "$ref": "#/$defs/scope" },
    "period": {
      "type": "object",
      "required": ["kind", "tz"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["monthly"] },
        "tz": { "type": "string", "description": "IANA timezone name; UTC default" }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "download_bps": { "type": ["integer", "null"], "minimum": 0, "description": "bit/s; null = unlimited; 0 = forbidden" },
            "upload_bps": { "type": ["integer", "null"], "minimum": 0 },
            "download_burst_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "upload_burst_bytes": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "total_bytes": { "type": ["integer", "null"], "minimum": 0, "description": "download+upload aggregate per period; null = unlimited; 0 = zero quota" }
      }
    }
  }
}
