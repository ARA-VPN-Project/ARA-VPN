#!/bin/sh
set -eu
action=${1:-}
name=${2:-}
case "$name" in
    ara-wg-*) ;;
    *) echo 'ARA WireGuard requires an ara-wg-* interface' >&2; exit 2 ;;
esac
case "$name" in
    *[!A-Za-z0-9_-]*) exit 2 ;;
esac
[ "${#name}" -le 15 ] || exit 2
config="/etc/ara-edge/backbones/wireguard/$name.conf"

case "$action" in
    up|check)
        # Validate and execute the same root-private snapshot. The allowlist
        # excludes wg-quick DNS updates, hooks, and SaveConfig.
        work=$(mktemp -d)
        trap 'rm -rf "$work"' EXIT
        install -m 0600 "${3:-$config}" "$work/$name.conf"
        awk '
            { sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
            /^$/ { next }
            /^\[Interface\]$/ { if (++interfaces != 1) exit 2; section = "interface"; next }
            /^\[Peer\]$/ { if (!interfaces) exit 2; section = "peer"; next }
            section == "interface" && /^Table[[:space:]]*=[[:space:]]*off$/ {
                if (++tables != 1) exit 2
                next
            }
            section == "interface" && /^Address[[:space:]]*=/ {
                if (++addresses != 1) exit 2
                sub(/^[^=]*=[[:space:]]*/, "")
                if ($0 !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/) exit 2
                split($0, n, /[.\/]/)
                for (i=1; i<=4; i++) if (n[i] > 255) exit 2
                if (n[5] < 24 || n[5] > 32) exit 2
                if (n[1] != 10 && !(n[1] == 172 && n[2] >= 16 && n[2] <= 31) && !(n[1] == 192 && n[2] == 168)) exit 2
                next
            }
            section == "interface" && /^(PrivateKey|ListenPort|MTU)[[:space:]]*=/ { next }
            section == "peer" && /^(PublicKey|PresharedKey|AllowedIPs|Endpoint|PersistentKeepalive)[[:space:]]*=/ { next }
            { exit 2 }
            END { if (tables != 1 || addresses != 1) exit 2 }
        ' "$work/$name.conf" || {
            echo 'Unsafe ARA WireGuard config: Table = off required, hooks and DNS forbidden' >&2
            exit 2
        }
        if [ "$action" = up ]; then /usr/bin/wg-quick up "$work/$name.conf"; fi
        ;;
    down)
        # No hooks on teardown, including if the saved file changed since up.
        /usr/sbin/ip link delete dev "$name"
        ;;
    *) exit 2 ;;
esac
